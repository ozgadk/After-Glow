rules_version = '2';

// Afterglow — Firestore security rules
// Deployed automatically by .github/workflows/deploy-rules.yml on push to main.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function needsApproval(barId) {
      let p = /databases/$(database)/documents/bars/$(barId);
      return exists(p) && get(p).data.get('requireApproval', false) == true;
    }

    function isCurrentRound(barId, round) {
      let p = /databases/$(database)/documents/bars/$(barId);
      return (!exists(p) && round == 'r1')
        || (exists(p) && round == 'r' + string(get(p).data.get('currentRound', 1)));
    }

    function validNewNote(barId) {
      let d = request.resource.data;
      let photo = /databases/$(database)/documents/bars/$(barId)/photos/$(request.resource.id);
      let withPhoto = d.get('hasPhoto', false) == true;
      return d.keys().hasOnly(['table', 'text', 'nick', 'mood', 'status', 'reportCount', 'createdAt', 'uid', 'hasPhoto'])
        && d.keys().hasAll(['table', 'text', 'status', 'reportCount', 'createdAt', 'uid'])
        && d.table is string && d.table.size() > 0 && d.table.size() <= 10
        && d.text is string && d.text.size() <= 280
        && (d.text.size() >= 1 || withPhoto)
        // photo notes are always reviewed first, and must arrive with their photo
        && (!withPhoto || (d.status == 'pending' && existsAfter(photo)))
        && (!('nick' in d) || (d.nick is string && d.nick.size() <= 24))
        && (!('mood' in d) || (d.mood is string && d.mood.size() <= 8))
        && (((needsApproval(barId) || withPhoto) && d.status == 'pending')
            || (!needsApproval(barId) && !withPhoto && d.status == 'visible'))
        && d.reportCount == 0
        && d.createdAt == request.time
        && d.uid == request.auth.uid
        // must be written in the same batch as a rate-limit stamp (max 1 note / 30 s)
        && getAfter(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data.last == request.time;
    }

    function validReport(barId, noteId) {
      let r = /databases/$(database)/documents/bars/$(barId)/notes/$(noteId)/reports/$(request.auth.uid);
      return signedIn()
        && resource.data.status == 'visible'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
        && request.resource.data.reportCount == resource.data.reportCount + 1
        && !exists(r) && existsAfter(r);
    }

    // Admin list: documents are created by hand in the console (doc id = admin's uid)
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /bars/{barId} {
      allow read: if true;
      allow write: if isAdmin();

      match /notes/{noteId} {
        allow read: if resource.data.status == 'visible' || isAdmin();
        allow create: if signedIn() && validNewNote(barId);
        allow update: if isAdmin() || validReport(barId, noteId);
        allow delete: if isAdmin();

        match /reports/{uid} {
          allow create: if signedIn() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['createdAt'])
            && request.resource.data.createdAt == request.time;
          allow read, delete: if isAdmin();
        }
      }

      // Living Painting: words go into the bar's *current* round only
      match /rounds/{round}/strokes/{strokeId} {
        allow read: if true;
        allow create: if signedIn()
          && isCurrentRound(barId, round)
          && request.resource.data.keys().hasOnly(['word', 'color', 'table', 'createdAt', 'uid'])
          && request.resource.data.keys().hasAll(['word', 'color', 'createdAt', 'uid'])
          && request.resource.data.word is string
          && request.resource.data.word.size() >= 1 && request.resource.data.word.size() <= 20
          && request.resource.data.color in ['joy', 'love', 'dream', 'calm', 'wild', 'gold']
          && (!('table' in request.resource.data) || (request.resource.data.table is string && request.resource.data.table.size() <= 10))
          && request.resource.data.createdAt == request.time
          && request.resource.data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/strokeLimits/$(request.auth.uid)).data.last == request.time;
        allow delete: if isAdmin();
      }

      // Round summary (words, prompt, status) — written by the host screen / admin
      match /rounds/{round} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Finished round image (JPEG data URL)
      match /roundImages/{round} {
        allow read: if true;
        allow write: if isAdmin()
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 950000;
        allow delete: if isAdmin();
      }

      // Saved nightly paintings (JPEG data URL), written by an admin's screen or panel
      match /paintings/{night} {
        allow read: if true;
        allow write: if isAdmin()
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 950000;
        allow delete: if isAdmin();
      }

      // Photos live apart from notes so note lists stay light; loaded one by one.
      match /photos/{noteId} {
        allow read: if isAdmin()
          || get(/databases/$(database)/documents/bars/$(barId)/notes/$(noteId)).data.status == 'visible';
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['data', 'createdAt', 'uid'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 900000
          && request.resource.data.createdAt == request.time
          && request.resource.data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/bars/$(barId)/notes/$(noteId)).data.get('hasPhoto', false) == true
          && getAfter(/databases/$(database)/documents/bars/$(barId)/notes/$(noteId)).data.uid == request.auth.uid
          && !exists(/databases/$(database)/documents/bars/$(barId)/notes/$(noteId));
        allow delete: if isAdmin();
      }
    }

    match /strokeLimits/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == request.time
        && (resource == null || request.time > resource.data.last + duration.value(8, 's'));
    }

    match /rateLimits/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == request.time
        && (resource == null || request.time > resource.data.last + duration.value(30, 's'));
    }
  }
}
